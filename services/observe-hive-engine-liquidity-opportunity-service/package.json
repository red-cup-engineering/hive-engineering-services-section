{
  "name": "@red-cup-engineering/observe-hive-engine-liquidity-opportunity-service",
  "version": "0.1.2",
  "description": "Keyless, block-bounded observation of Hive-Engine constant-product liquidity opportunities.",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    },
    "./observe": "./scripts/observe-hive-engine-liquidity-opportunity.mjs"
  },
  "bin": {
    "observe-hive-engine-liquidity-opportunity": "./scripts/observe-hive-engine-liquidity-opportunity.mjs"
  },
  "scripts": {
    "check": "node --check src/index.mjs && node --check scripts/observe-hive-engine-liquidity-opportunity.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@red-cup-engineering/normalize-earning-opportunity-service": "0.1.1",
    "@red-cup-engineering/hive-blockchain-client-service": "0.1.5"
  },
  "private": false
}
